# Copy to backend/.env and fill in. Never commit the real file.
SYLVAN_STORAGE_DIR=storage

# Google Earth Engine (choose ONE: interactive auth via `earthengine authenticate`, or a service account)
SYLVAN_EE_PROJECT=your-gcp-project-id
# SYLVAN_EE_SERVICE_ACCOUNT=sylvan@your-gcp-project-id.iam.gserviceaccount.com
# SYLVAN_EE_PRIVATE_KEY_FILE=/secrets/ee-key.json

# Dataset versions: verify these IDs in the Earth Engine catalogue (Hansen updates yearly)
SYLVAN_HANSEN_ASSET=UMD/hansen/global_forest_change_2024_v1_12
SYLVAN_S2_ASSET=COPERNICUS/S2_SR_HARMONIZED
SYLVAN_WORLDCOVER_ASSET=ESA/WorldCover/v200

SYLVAN_MAX_AOI_KM=15
SYLVAN_MIN_DETECTION_HA=0.5
SYLVAN_CORS_ORIGINS=["http://localhost:3000"]
